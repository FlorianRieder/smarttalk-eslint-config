# Zeilenenden im Repository normalisieren.
#
# Git speichert mit `text=auto` immer LF und laesst im Arbeitsverzeichnis die
# Plattform-Konvention zu. Quell-, Konfigurations- und Skriptdateien werden
# zusaetzlich mit LF ausgecheckt: sie laufen in Linux-Containern und auf dem
# VPS, und ein Shell-Skript mit CRLF bricht am Shebang
# ("/usr/bin/env: 'bash\r': No such file or directory") — so geschehen beim
# ersten Cutover des Backoffice. Diese Datei ist in allen SmartTalk-Repos
# gleich; Abweichungen bitte hier begruenden.

* text=auto

# Immer LF: wird maschinell verglichen oder in Linux-Umgebungen ausgefuehrt.
*.sh     text eol=lf
*.bash   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.ejs    text eol=lf
*.sql    text eol=lf
*.py     text eol=lf
*.conf   text eol=lf
*.cron   text eol=lf
*.prisma text eol=lf
Dockerfile*     text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.env.example    text eol=lf

# Binaerdateien nie anfassen.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.svg    text eol=lf
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
*.zip    binary
*.db     binary
*.sqlite binary
*.xlsx   binary
*.docx   binary
*.pptx   binary
